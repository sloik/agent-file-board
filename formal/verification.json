{
  "schemaVersion": 1,
  "traceModels": [
    "PrivateState.tla",
    "Publication.tla",
    "PrivateRecovery.tla",
    "AnswerAcceptance.tla"
  ],
  "phases": [
    {
      "name": "prepare",
      "commands": [
        [
          "{python}",
          "scripts/ci_retry.py",
          "--seconds",
          "60",
          "--",
          "{python}",
          "-m",
          "pip",
          "install",
          "-r",
          "requirements-signing.txt",
          "--timeout",
          "15",
          "--retries",
          "1"
        ]
      ],
      "timeout": 180
    },
    {
      "name": "harness",
      "commands": [
        [
          "{python}",
          "-m",
          "unittest",
          "discover",
          "-s",
          "formal",
          "-p",
          "test_*.py"
        ]
      ],
      "timeout": 60
    },
    {
      "name": "regressions",
      "commands": [
        [
          "{python}",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_signing_runtime.py"
        ],
        [
          "{python}",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_answer_state.py"
        ]
      ],
      "timeout": 180
    },
    {
      "name": "traces",
      "commands": [
        [
          "{python}",
          "formal/check_traces.py"
        ]
      ],
      "timeout": 180
    },
    {
      "name": "models",
      "commands": [
        [
          "{python}",
          "formal/check.py"
        ]
      ],
      "timeout": 360
    }
  ]
}
