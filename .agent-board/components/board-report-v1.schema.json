{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-file-board:board-report:1",
  "title": "board-report version 1",
  "description": "Also enforce nonblank strings, matching row/column and label/value lengths, Unicode scalar text and maximum 16384 UTF-8 bytes for the single-line UI header. See CONVENTION.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "library",
    "version",
    "title",
    "components"
  ],
  "properties": {
    "library": {
      "const": "board-report"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+(?![\\s\\S])"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "title",
              "columns",
              "rows"
            ],
            "properties": {
              "type": {
                "const": "table"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+(?![\\s\\S])"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+(?![\\s\\S])"
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "^[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+(?![\\s\\S])"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "title",
              "labels",
              "values"
            ],
            "properties": {
              "type": {
                "const": "bar-chart"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+(?![\\s\\S])"
              },
              "labels": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+(?![\\s\\S])"
                }
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "number",
                  "minimum": -1000000000000.0,
                  "maximum": 1000000000000.0
                }
              }
            }
          }
        ]
      }
    }
  }
}
