{
  "version": 1,
  "project": {
    "id": "example-project",
    "name": "Example project",
    "source_of_truth": "Project documentation and code, not this board"
  },
  "language": {
    "default": "en",
    "allowed": ["en"],
    "project_artifacts": "en",
    "topic_defaults": {}
  },
  "time_zone": "Europe/Warsaw",
  "board": {
    "directory": ".agent-board",
    "default_room": "general",
    "direct_directory": "direct",
    "message_extension": ".txt",
    "thread_prefix": "T",
    "thread_digits": 3
  },
  "participant_identity": {
    "registry_file": ".agent-board/participants.json",
    "id_pattern": "^[a-z][a-z0-9-]{2,63}$",
    "uniqueness_scope": "project",
    "state_directory_environment": "AGENT_FILE_BOARD_STATE_DIR"
  },
  "statuses": [
    "INFO",
    "QUESTION",
    "REQUEST",
    "REPLY",
    "DECISION-NEEDED",
    "DONE",
    "CLOSED"
  ],
  "safety": {
    "forbidden_content": [
      "credentials",
      "API keys",
      "payment data",
      "personal data",
      "sensitive source documents"
    ]
  }
}
